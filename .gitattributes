# Set default behavior to automatic text conversion.
* text=auto

# Enforce LF line endings for Python files across all platforms (Windows / Linux CI)
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
