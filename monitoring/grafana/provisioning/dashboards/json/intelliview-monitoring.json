{
  "title": "IntelliView Orchestrator Monitoring",
  "uid": "intelliview-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "-- Grafana --"
      },
      "targets": [
        {
          "expr": "sum(rate(intelliview_http_requests_total[5m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "API Error Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "-- Grafana --"
      },
      "targets": [
        {
          "expr": "sum(rate(intelliview_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(intelliview_http_requests_total[5m])) * 100",
          "legendFormat": "5xx Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "API Response Time (P95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "-- Grafana --"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(intelliview_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Response Time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Worker Health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "-- Grafana --"
      },
      "targets": [
        {
          "expr": "intelliview_workers_registered",
          "legendFormat": "Registered",
          "refId": "A"
        },
        {
          "expr": "intelliview_workers_healthy",
          "legendFormat": "Healthy",
          "refId": "B"
        },
        {
          "expr": "intelliview_workers_unhealthy",
          "legendFormat": "Unhealthy",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "Queue Depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "-- Grafana --"
      },
      "targets": [
        {
          "expr": "intelliview_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "Active Sessions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "-- Grafana --"
      },
      "targets": [
        {
          "expr": "intelliview_sessions_active",
          "legendFormat": "Active Sessions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    }
  ]
}